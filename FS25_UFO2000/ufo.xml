<?xml version="1.0" encoding="utf-8" standalone="no"?>
<vehicle type="UFO2000" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://validation.gdn.giants-software.com/xml/fs25/vehicle.xsd">
    <annotation>UFO 2000 - the cute little saucer from the Alf days, rebuilt for FS25. Model, textures and sounds are generated by tools/ufo/*.py.</annotation>

    <storeData>
        <name>$l10n_ufo_name</name>
        <specs>
            <power>113</power>
            <maxSpeed>32</maxSpeed>
        </specs>
        <functions>
            <function>$l10n_function_ufo</function>
        </functions>
        <image>store_ufo.png</image>
        <price>42000</price>
        <lifetime>600</lifetime>
        <rotation>0</rotation>
        <brand>UFO2000</brand>
        <category>cars</category>
        <shopTranslationOffset>0 0.06 0</shopTranslationOffset>
        <shopRotationOffset>0 0 0</shopRotationOffset>
        <vertexBufferMemoryUsage>0</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>0</indexBufferMemoryUsage>
        <textureMemoryUsage>0</textureMemoryUsage>
        <audioMemoryUsage>0</audioMemoryUsage>
    </storeData>

    <base>
        <typeDesc>$l10n_typeDesc_ufo</typeDesc>
        <filename>ufo.i3d</filename>
        <size width="4.7" length="4.7" height="2.3"/>
        <speedLimit value="32"/>
        <components>
            <!-- one rigid body: the hull collision cylinder (r 2.02 m, 0.8 m tall) + the dome -->
            <component centerOfMass="0 0.55 0" solverIterationCount="20" mass="1450"/>
        </components>
        <schemaOverlay name="CAR" attacherJointPosition="0 0"/>
        <mapHotspot type="CAR"/>
    </base>

    <wheels>
        <wheelConfigurations>
            <!-- no wheels: every part of the craft is a mesh, the loader is skipped
                 automatically when no wheel entry is found -->
            <wheelConfiguration name="$l10n_configuration_valueDefault" price="0" saveId="DEFAULT">
                <wheels/>
            </wheelConfiguration>
        </wheelConfigurations>
    </wheels>

    <enterable isTabbable="true">
        <exitPoint node="exitPoint"/>
        <enterReferenceNode node="enterReferenceNode" interactionRadius="5"/>
        <cameras>
            <camera node="outdoorCamera" rotatable="true" rotateNode="outdoorCameraTarget" limit="true" useWorldXZRotation="true" rotMinX="-1.6" rotMaxX="1.1" transMin="4" transMax="45" translation="0 0 9" rotation="-14 180 0"/>
            <camera node="indoorCamera" rotatable="true" limit="true" rotMinX="-1.0" rotMaxX="0.6" transMin="0" transMax="0" isInside="true"/>
        </cameras>
    </enterable>

    <lights>
        <states>
            <state lightTypes="0"/>
            <state lightTypes="0 1"/>
        </states>

        <realLights>
            <low>
                <light node="headLightLeft" lightTypes="0"/>
                <light node="headLightRight" lightTypes="0"/>
                <light node="workLight" lightTypes="1"/>
                <light node="tailLight" lightTypes="0"/>
                <light node="beaconLight" lightTypes="0 1"/>
            </low>
            <high>
                <light node="headLightLeft" lightTypes="0"/>
                <light node="headLightRight" lightTypes="0"/>
                <light node="workLight" lightTypes="1"/>
                <light node="tailLight" lightTypes="0"/>
                <light node="beaconLight" lightTypes="0 1"/>
            </high>
        </realLights>
    </lights>

    <motorized>
        <consumerConfigurations>
            <consumerConfiguration>
                <!-- diesel from the tank; the craft needs 6 l/h just to float -->
                <consumer fillUnitIndex="1" usage="9" fillType="diesel"/>
            </consumerConfiguration>
        </consumerConfigurations>

        <motorConfigurations>
            <motorConfiguration name="$l10n_configuration_ufo_motor" hp="113" price="0" consumerConfigurationIndex="1">
                <!-- fictional "anti-gravity" drive: a flat torque curve, no gears, 32 km/h -->
                <motor minRpm="800" maxRpm="2600" maxForwardSpeed="32" maxBackwardSpeed="18" accelerationLimit="6" brakeForce="6" lowBrakeForceScale="1" ptoMotorRpmRatio="0">
                    <torque rpm="800" torque="0.30"/>
                    <torque rpm="1600" torque="0.38"/>
                    <torque rpm="2600" torque="0.32"/>
                </motor>
                <transmission gearChangeTime="0" autoGearChangeTime="0.2" name="$l10n_info_transmission_automatic">
                    <directionChange useGear="false" changeTime="0.3"/>
                    <forwardGear maxSpeed="32" name="D"/>
                    <backwardGear maxSpeed="18" name="R"/>
                </transmission>
            </motorConfiguration>
        </motorConfigurations>

        <sounds>
            <motorStart file="sounds/hoverStart.ogg" linkNode="soundMotor" innerRadius="6" outerRadius="120">
                <volume indoor="0.7" outdoor="0.9"/>
            </motorStart>
            <motorStop file="sounds/hoverStop.ogg" linkNode="soundMotor" innerRadius="6" outerRadius="120">
                <volume indoor="0.7" outdoor="0.9"/>
            </motorStop>

            <!-- hover hum: three rpm windows plus a "load" layer, all pitched to the motor rpm -->
            <motor file="sounds/hoverIdle.ogg" linkNode="soundMotor" innerRadius="8" outerRadius="130" fadeIn="0.3" fadeOut="0.3">
                <volume indoor="0.85" outdoor="1.0">
                    <modifier type="MOTOR_RPM_REAL" value="700" modifiedValue="1"/>
                    <modifier type="MOTOR_RPM_REAL" value="900" modifiedValue="1"/>
                    <modifier type="MOTOR_RPM_REAL" value="1000" modifiedValue="0.8"/>
                    <modifier type="MOTOR_RPM_REAL" value="1100" modifiedValue="0.45"/>
                    <modifier type="MOTOR_RPM_REAL" value="1200" modifiedValue="0"/>
                    <modifier type="MOTOR_LOAD" value="0.0" modifiedValue="1.0"/>
                    <modifier type="MOTOR_LOAD" value="1.0" modifiedValue="0.55"/>
                </volume>
                <pitch indoor="1" outdoor="1">
                    <modifier type="MOTOR_RPM_REAL" value="800" modifiedValue="1"/>
                    <modifier type="MOTOR_RPM_REAL" value="2600" modifiedValue="3.25"/>
                </pitch>
            </motor>
            <motor file="sounds/hoverMid.ogg" linkNode="soundMotor" innerRadius="8" outerRadius="130" fadeIn="0.3" fadeOut="0.3">
                <volume indoor="0.85" outdoor="1.0">
                    <modifier type="MOTOR_RPM_REAL" value="1100" modifiedValue="0"/>
                    <modifier type="MOTOR_RPM_REAL" value="1250" modifiedValue="0.5"/>
                    <modifier type="MOTOR_RPM_REAL" value="1400" modifiedValue="1"/>
                    <modifier type="MOTOR_RPM_REAL" value="1750" modifiedValue="1"/>
                    <modifier type="MOTOR_RPM_REAL" value="1900" modifiedValue="0.5"/>
                    <modifier type="MOTOR_RPM_REAL" value="2050" modifiedValue="0"/>
                    <modifier type="MOTOR_LOAD" value="0.0" modifiedValue="1.0"/>
                    <modifier type="MOTOR_LOAD" value="1.0" modifiedValue="0.7"/>
                </volume>
                <pitch indoor="1" outdoor="1">
                    <modifier type="MOTOR_RPM_REAL" value="800" modifiedValue="0.5"/>
                    <modifier type="MOTOR_RPM_REAL" value="2600" modifiedValue="1.625"/>
                </pitch>
            </motor>
            <motor file="sounds/hoverHigh.ogg" linkNode="soundMotor" innerRadius="8" outerRadius="130" fadeIn="0.3" fadeOut="0.3">
                <volume indoor="0.85" outdoor="1.0">
                    <modifier type="MOTOR_RPM_REAL" value="1950" modifiedValue="0"/>
                    <modifier type="MOTOR_RPM_REAL" value="2150" modifiedValue="0.5"/>
                    <modifier type="MOTOR_RPM_REAL" value="2300" modifiedValue="1"/>
                    <modifier type="MOTOR_RPM_REAL" value="2700" modifiedValue="1"/>
                    <modifier type="MOTOR_LOAD" value="0.0" modifiedValue="1.0"/>
                    <modifier type="MOTOR_LOAD" value="1.0" modifiedValue="0.8"/>
                </volume>
                <pitch indoor="1" outdoor="1">
                    <modifier type="MOTOR_RPM_REAL" value="800" modifiedValue="0.333"/>
                    <modifier type="MOTOR_RPM_REAL" value="2600" modifiedValue="1.083"/>
                </pitch>
            </motor>
            <motor file="sounds/hoverLoad.ogg" linkNode="soundMotor" innerRadius="8" outerRadius="130" fadeIn="0.3" fadeOut="0.3">
                <volume indoor="0.85" outdoor="1.0">
                    <modifier type="MOTOR_RPM_REAL" value="1400" modifiedValue="0"/>
                    <modifier type="MOTOR_RPM_REAL" value="1700" modifiedValue="0.6"/>
                    <modifier type="MOTOR_RPM_REAL" value="2000" modifiedValue="1"/>
                    <modifier type="MOTOR_LOAD" value="0.0" modifiedValue="0"/>
                    <modifier type="MOTOR_LOAD" value="0.5" modifiedValue="0.35"/>
                    <modifier type="MOTOR_LOAD" value="1.0" modifiedValue="0.9"/>
                </volume>
                <pitch indoor="1" outdoor="1">
                    <modifier type="MOTOR_RPM_REAL" value="800" modifiedValue="0.4"/>
                    <modifier type="MOTOR_RPM_REAL" value="2600" modifiedValue="1.3"/>
                </pitch>
            </motor>
        </sounds>
    </motorized>

    <honk>
        <!-- the little alien says hello -->
        <sound file="sounds/greeting.ogg" linkNode="soundMotor" linkNodeOffset="0 0.4 0.6" innerRadius="8" outerRadius="110" loops="1">
            <volume indoor="0.8" outdoor="1.0"/>
        </sound>
    </honk>

    <fillUnit>
        <fillUnitConfigurations>
            <fillUnitConfiguration>
                <fillUnits>
                    <fillUnit unitTextOverride="$l10n_unit_literShort" showOnHud="false" showInShop="false" fillTypes="diesel" capacity="90">
                        <exactFillRootNode node="exactFillRootNode"/>
                    </fillUnit>
                </fillUnits>
            </fillUnitConfiguration>
        </fillUnitConfigurations>
    </fillUnit>

    <!-- I3D_MAPPINGS -->
    <i3dMappings>
        <i3dMapping id="ufo_main_component1" node="0>"/>
        <i3dMapping id="visual" node="0>0"/>
        <i3dMapping id="hullMesh" node="0>0|0"/>
        <i3dMapping id="domeGlass" node="0>0|1"/>
        <i3dMapping id="leg0" node="0>0|2"/>
        <i3dMapping id="leg0Mesh" node="0>0|2|0"/>
        <i3dMapping id="leg1" node="0>0|3"/>
        <i3dMapping id="leg1Mesh" node="0>0|3|0"/>
        <i3dMapping id="leg2" node="0>0|4"/>
        <i3dMapping id="leg2Mesh" node="0>0|4|0"/>
        <i3dMapping id="alienNode" node="0>0|5"/>
        <i3dMapping id="alienMesh" node="0>0|5|0"/>
        <i3dMapping id="consoleMesh" node="0>0|6"/>
        <i3dMapping id="beaconNode" node="0>0|7"/>
        <i3dMapping id="beaconMesh" node="0>0|7|0"/>
        <i3dMapping id="beamNode" node="0>0|8"/>
        <i3dMapping id="beamMesh" node="0>0|8|0"/>
        <i3dMapping id="collisions" node="0>1"/>
        <i3dMapping id="collisionDome" node="0>1|0"/>
        <i3dMapping id="lights" node="0>2"/>
        <i3dMapping id="headLightLeft" node="0>2|0"/>
        <i3dMapping id="headLightRight" node="0>2|1"/>
        <i3dMapping id="workLight" node="0>2|2"/>
        <i3dMapping id="beamLight" node="0>2|3"/>
        <i3dMapping id="beaconLight" node="0>2|4"/>
        <i3dMapping id="tailLight" node="0>2|5"/>
        <i3dMapping id="exactFillRootNode" node="0>3"/>
        <i3dMapping id="enterReferenceNode" node="0>4"/>
        <i3dMapping id="exitPoint" node="0>5"/>
        <i3dMapping id="soundMotor" node="0>6"/>
        <i3dMapping id="outdoorCameraTarget" node="0>7"/>
        <i3dMapping id="outdoorCamera" node="0>7|0"/>
        <i3dMapping id="indoorCameraTarget" node="0>8"/>
        <i3dMapping id="indoorCamera" node="0>8|0"/>
    </i3dMappings>
    <!-- /I3D_MAPPINGS -->
</vehicle>
