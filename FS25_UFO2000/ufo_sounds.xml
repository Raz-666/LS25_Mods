<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!-- Extra samples of the UFO 2000: the beep of the mode dial and the humming
     loops of the working beam.  Loaded from scripts/UFO2000.lua with
     g_soundManager:loadSampleFromXML. -->
<sounds>
    <ufo2000>
        <modeSwitch file="sounds/modeSwitch.ogg" linkNode="soundMotor" innerRadius="5"
                    outerRadius="60" loops="1" fadeOut="0.1">
            <volume indoor="0.9" outdoor="1.0"/>
        </modeSwitch>
        <beamLoop file="sounds/beamLoop.ogg" linkNode="soundMotor" innerRadius="6"
                  outerRadius="90" loops="0" fadeIn="0.25" fadeOut="0.25">
            <volume indoor="0.55" outdoor="0.85"/>
        </beamLoop>
        <loadLoop file="sounds/loadLoop.ogg" linkNode="soundMotor" innerRadius="6"
                  outerRadius="80" loops="0" fadeIn="0.15" fadeOut="0.2">
            <volume indoor="0.6" outdoor="0.9"/>
        </loadLoop>
        <unloadLoop file="sounds/unloadLoop.ogg" linkNode="soundMotor" innerRadius="6"
                    outerRadius="80" loops="0" fadeIn="0.15" fadeOut="0.2">
            <volume indoor="0.6" outdoor="0.9"/>
        </unloadLoop>
    </ufo2000>
</sounds>
