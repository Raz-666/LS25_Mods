<?xml version="1.0" encoding="utf-8" standalone="no"?>
<placeable type="distillery" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://validation.gdn.giants-software.com/xml/fs25/placeable.xsd">
    <annotation>
        FS25_Distillery - the Leipzig techno club. A reused brick factory with a
        main floor, bar wing, foyer and beer garden. The PA keeps running for
        everybody: the server owns the set list (index + common start time), so
        every player hears the same record at the same second. The lit set list
        board at the DJ booth shows the tracks, the amber marker bar shows which
        one is running, and any player standing at the mixer can skip it.
    </annotation>

    <storeData>
        <name>$l10n_distillery_name</name>
        <image>store_distillery.png</image>
        <price>185000</price>
        <functions>
            <function>$l10n_distillery_function</function>
        </functions>
        <lifetime>1000</lifetime>
        <dailyUpkeep>180</dailyUpkeep>
        <rotation>0</rotation>
        <brand>LIZARD</brand>
        <species>PLACEABLE</species>
        <category>placeableMisc</category>
        <brush>
            <type>placeable</type>
            <category>object</category>
        </brush>
        <vertexBufferMemoryUsage>0</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>0</indexBufferMemoryUsage>
        <textureMemoryUsage>0</textureMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
        <storeIconRendering>
            <settings cameraXRot="-14" cameraYRot="28" cameraZoom="0.6" advancedBoundingBox="true"/>
        </storeIconRendering>
        <audioMemoryUsage>0</audioMemoryUsage>
    </storeData>

    <base>
        <filename>distillery.i3d</filename>
        <boughtWithFarmland>true</boughtWithFarmland>
        <canBeDeleted>true</canBeDeleted>
        <canBeRenamed>true</canBeRenamed>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true">
        <testAreas>
            <testArea startNode="testArea1" endNode="testArea1End"/>
        </testAreas>
        <sounds>
            <place template="smallImp"/>
            <placeLayered template="buildingPlacement"/>
        </sounds>
    </placement>

    <clearAreas>
        <clearArea startNode="clearArea1" widthNode="clearArea1Width" heightNode="clearArea1Height"/>
    </clearAreas>

    <leveling requireLeveling="true" maxSmoothDistance="10" maxSlope="60" maxEdgeAngle="30">
        <levelAreas>
            <levelArea startNode="levelArea1" widthNode="levelArea1Width" heightNode="levelArea1Height" groundType="dirt"/>
        </levelAreas>
        <paintAreas>
            <paintArea startNode="paintArea1" widthNode="paintArea1Width" heightNode="paintArea1Height" groundType="concrete"/>
        </paintAreas>
    </leveling>

    <indoorAreas>
        <indoorArea startNode="indoorArea1" widthNode="indoorArea1Width" heightNode="indoorArea1Height"/>
    </indoorAreas>

    <foliageAreas>
        <foliageArea startNode="foliageArea1" widthNode="foliageArea1Width" heightNode="foliageArea1Height"/>
    </foliageAreas>

    <ai>
        <updateAreas>
            <updateArea startNode="testArea1" endNode="testArea1End"/>
        </updateAreas>
    </ai>

    <!-- I3D_MAPPINGS -->
