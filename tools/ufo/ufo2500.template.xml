<?xml version="1.0" encoding="utf-8" standalone="no"?>
<vehicle type="UFO2500" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://validation.gdn.giants-software.com/xml/fs25/vehicle.xsd">
    <annotation>
        UFO 2500 - console edition. No Lua of its own: a plain vehicle that rolls
        on two wide invisible wheels 18.83 m below the saucer. Model, textures
        and sounds are generated by tools/ufo/*.py in this repository.
    </annotation>

    <storeData>
        <name>$l10n_ufo2500_name</name>
        <specs>
            <power>120</power>
            <maxSpeed>32</maxSpeed>
        </specs>
        <functions>
            <function>$l10n_function_ufo2500</function>
        </functions>
        <image>store_ufo2500.png</image>
        <price>38000</price>
        <lifetime>600</lifetime>
        <rotation>0</rotation>
        <!-- Lizard is a base game brand, so the mod works on console as well -->
        <brand>LIZARD</brand>
        <category>cars</category>
        <shopTranslationOffset>0 -0.05 0</shopTranslationOffset>
        <shopRotationOffset>0 0 0</shopRotationOffset>
        <vertexBufferMemoryUsage>0</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>0</indexBufferMemoryUsage>
        <textureMemoryUsage>0</textureMemoryUsage>
        <audioMemoryUsage>0</audioMemoryUsage>
    </storeData>

    <base>
        <typeDesc>$l10n_typeDesc_ufo2500</typeDesc>
        <filename>ufo2500.i3d</filename>
        <size width="4.7" length="4.7" height="21.6"/>
        <speedLimit value="32"/>
        <components>
            <!-- one rigid body; the collision sits 19 m up with the saucer,
                 the centre of mass is pulled down so it cannot tip over -->
            <component centerOfMass="0 1.0 0" solverIterationCount="20" mass="1800"/>
        </components>
        <schemaOverlay name="CAR" attacherJointPosition="0 0"/>
        <mapHotspot type="CAR"/>
    </base>

    <!--
        invisible wheels: no <wheel filename="..."> is given, so the game loads
        the physics only (WheelVisual:loadFromXML drops the visual wheel, the
        physics keeps running).

        * wheelFront / wheelRear - two wide wheels in line, like a motorcycle
                                   with fat tyres. isCareWheel, so they never
                                   touch the crop.
        * wheelOutrigger*        - two tiny hidden wheels that keep the craft
                                   from tipping over sideways (5 cm wide, care
                                   wheels, almost no lateral grip)
        * wheelBrush*            - the brush row: up to 15 x 0.5 m, pressed into
                                   the crop by the base game wheel destruction
    -->
    <wheels>
        <wheelConfigurations>
            <!-- WHEELS -->
        </wheelConfigurations>
    </wheels>

    <!--
        Landing without a script: the base game "foldable" specialization plays
        this AnimatedVehicle animation when the player presses the fold key.
        Time 0 = flying (craft 18.83 m up), time 1 = landed (craft at street
        level, legs out, beam shrunk to a landing spot).
    -->
    <animations>
        <animation name="landing">
            <part node="visual" startTime="0" endTime="4.5" startTrans="0 18.83 0" endTrans="0 0.95 0"/>
            <part node="leg0" startTime="0.6" endTime="4.0" startRot="0 -30 90" endRot="0 -30 16"/>
            <part node="leg1" startTime="0.6" endTime="4.0" startRot="0 -150 90" endRot="0 -150 16"/>
            <part node="leg2" startTime="0.6" endTime="4.0" startRot="0 -270 90" endRot="0 -270 16"/>
            <part node="beamNode" startTime="0.6" endTime="4.0" startScale="1.75 18.89 1.75" endScale="0.9 1.0 0.9"/>
            <part node="groundRing" startTime="0" endTime="4.5" startTrans="0 -18.76 0" endTrans="0 -0.88 0" startScale="1.75 1 1.75" endScale="0.9 1 0.9"/>
        </animation>
    </animations>

    <foldable>
        <foldingConfigurations>
            <foldingConfiguration name="$l10n_ufo2500_landing" price="0" saveId="DEFAULT">
                <!-- the fold key (default X on keyboard, "fold implements" on a
                     gamepad) lowers the saucer to the ground and back up -->
                <foldingParts startAnimTime="0" foldInputButton="IMPLEMENT_EXTRA2" requiresPower="true">
                    <foldingPart animationName="landing" speedScale="1"/>
                </foldingParts>
            </foldingConfiguration>
        </foldingConfigurations>
    </foldable>

    <enterable isTabbable="true">
        <!-- you get out on the ground, also when the craft is still up -->
        <exitPoint node="exitPoint"/>
        <enterReferenceNode node="enterReferenceNode" interactionRadius="6"/>
        <!-- your own character sits under the glass dome, 20 m above the field -->
        <characterNode node="driverSeatNode" cameraMinDistance="0.5"/>
        <cameras>
            <camera node="outdoorCamera" rotatable="true" rotateNode="outdoorCameraTarget" limit="true" useWorldXZRotation="true" rotMinX="-1.5" rotMaxX="1.0" transMin="8" transMax="90" translation="0 0 18" rotation="-14 180 0"/>
            <camera node="indoorCamera" rotatable="true" limit="true" rotMinX="-1.0" rotMaxX="0.6" transMin="0" transMax="0" isInside="true"/>
        </cameras>
    </enterable>

    <lights>
        <!-- two small base game beacon lights inside the cockpit: they blink
             and rotate while you are sitting in the saucer -->
        <beaconLights>
            <beaconLight node="cockpitBeacon1" filename="$data/shared/assets/beaconLights/lizard/beaconLight06.xml" alwaysActive="true" speed="2"/>
            <beaconLight node="cockpitBeacon2" filename="$data/shared/assets/beaconLights/lizard/beaconLight06.xml" alwaysActive="true" speed="2"/>
        </beaconLights>

        <states>
            <state lightTypes="0"/>
            <state lightTypes="0 1"/>
        </states>

        <realLights>
            <low>
                <light node="headLightLeft" lightTypes="0"/>
                <light node="headLightRight" lightTypes="0"/>
                <light node="workLight" lightTypes="1"/>
                <light node="beamLight" lightTypes="1"/>
                <light node="groundGlow" lightTypes="1"/>
                <light node="tailLight" lightTypes="0"/>
                <light node="beaconLight" lightTypes="0 1"/>
            </low>
            <high>
                <light node="headLightLeft" lightTypes="0"/>
                <light node="headLightRight" lightTypes="0"/>
                <light node="workLight" lightTypes="1"/>
                <light node="beamLight" lightTypes="1"/>
                <light node="groundGlow" lightTypes="1"/>
                <light node="tailLight" lightTypes="0"/>
                <light node="beaconLight" lightTypes="0 1"/>
            </high>
        </realLights>
    </lights>

    <motorized>
        <consumerConfigurations>
            <consumerConfiguration>
                <consumer fillUnitIndex="1" usage="9" fillType="diesel"/>
            </consumerConfiguration>
        </consumerConfigurations>

        <motorConfigurations>
            <motorConfiguration name="$l10n_configuration_valueDefault" hp="120" price="0" consumerConfigurationIndex="1">
                <motor minRpm="800" maxRpm="2600" maxForwardSpeed="32" maxBackwardSpeed="18" accelerationLimit="6" brakeForce="6" lowBrakeForceScale="1" ptoMotorRpmRatio="0">
                    <torque rpm="800" torque="0.32"/>
                    <torque rpm="1600" torque="0.40"/>
                    <torque rpm="2600" torque="0.34"/>
                </motor>
                <transmission gearChangeTime="0" autoGearChangeTime="0.2" name="$l10n_info_transmission_automatic">
                    <directionChange useGear="false" changeTime="0.3"/>
                    <forwardGear maxSpeed="32" name="D"/>
                    <backwardGear maxSpeed="18" name="R"/>
                </transmission>
            </motorConfiguration>
        </motorConfigurations>

        <sounds>
            <motorStart file="sounds/hoverStart.ogg" linkNode="soundMotor" innerRadius="6" outerRadius="120">
                <volume indoor="0.7" outdoor="0.9"/>
            </motorStart>
            <motorStop file="sounds/hoverStop.ogg" linkNode="soundMotor" innerRadius="6" outerRadius="120">
                <volume indoor="0.7" outdoor="0.9"/>
            </motorStop>

            <motor file="sounds/hoverIdle.ogg" linkNode="soundMotor" innerRadius="8" outerRadius="130" fadeIn="0.3" fadeOut="0.3">
                <volume indoor="0.85" outdoor="1.0">
                    <modifier type="MOTOR_RPM_REAL" value="700" modifiedValue="1"/>
                    <modifier type="MOTOR_RPM_REAL" value="900" modifiedValue="1"/>
                    <modifier type="MOTOR_RPM_REAL" value="1000" modifiedValue="0.8"/>
                    <modifier type="MOTOR_RPM_REAL" value="1100" modifiedValue="0.45"/>
                    <modifier type="MOTOR_RPM_REAL" value="1200" modifiedValue="0"/>
                    <modifier type="MOTOR_LOAD" value="0.0" modifiedValue="1.0"/>
                    <modifier type="MOTOR_LOAD" value="1.0" modifiedValue="0.55"/>
                </volume>
                <pitch indoor="1" outdoor="1">
                    <modifier type="MOTOR_RPM_REAL" value="800" modifiedValue="1"/>
                    <modifier type="MOTOR_RPM_REAL" value="2600" modifiedValue="3.25"/>
                </pitch>
            </motor>
            <motor file="sounds/hoverMid.ogg" linkNode="soundMotor" innerRadius="8" outerRadius="130" fadeIn="0.3" fadeOut="0.3">
                <volume indoor="0.85" outdoor="1.0">
                    <modifier type="MOTOR_RPM_REAL" value="1100" modifiedValue="0"/>
                    <modifier type="MOTOR_RPM_REAL" value="1250" modifiedValue="0.5"/>
                    <modifier type="MOTOR_RPM_REAL" value="1400" modifiedValue="1"/>
                    <modifier type="MOTOR_RPM_REAL" value="1750" modifiedValue="1"/>
                    <modifier type="MOTOR_RPM_REAL" value="1900" modifiedValue="0.5"/>
                    <modifier type="MOTOR_RPM_REAL" value="2050" modifiedValue="0"/>
                    <modifier type="MOTOR_LOAD" value="0.0" modifiedValue="1.0"/>
                    <modifier type="MOTOR_LOAD" value="1.0" modifiedValue="0.7"/>
                </volume>
                <pitch indoor="1" outdoor="1">
                    <modifier type="MOTOR_RPM_REAL" value="800" modifiedValue="0.5"/>
                    <modifier type="MOTOR_RPM_REAL" value="2600" modifiedValue="1.625"/>
                </pitch>
            </motor>
            <motor file="sounds/hoverHigh.ogg" linkNode="soundMotor" innerRadius="8" outerRadius="130" fadeIn="0.3" fadeOut="0.3">
                <volume indoor="0.85" outdoor="1.0">
                    <modifier type="MOTOR_RPM_REAL" value="1950" modifiedValue="0"/>
                    <modifier type="MOTOR_RPM_REAL" value="2150" modifiedValue="0.5"/>
                    <modifier type="MOTOR_RPM_REAL" value="2300" modifiedValue="1"/>
                    <modifier type="MOTOR_RPM_REAL" value="2700" modifiedValue="1"/>
                    <modifier type="MOTOR_LOAD" value="0.0" modifiedValue="1.0"/>
                    <modifier type="MOTOR_LOAD" value="1.0" modifiedValue="0.8"/>
                </volume>
                <pitch indoor="1" outdoor="1">
                    <modifier type="MOTOR_RPM_REAL" value="800" modifiedValue="0.333"/>
                    <modifier type="MOTOR_RPM_REAL" value="2600" modifiedValue="1.083"/>
                </pitch>
            </motor>
            <motor file="sounds/hoverLoad.ogg" linkNode="soundMotor" innerRadius="8" outerRadius="130" fadeIn="0.3" fadeOut="0.3">
                <volume indoor="0.85" outdoor="1.0">
                    <modifier type="MOTOR_RPM_REAL" value="1400" modifiedValue="0"/>
                    <modifier type="MOTOR_RPM_REAL" value="1700" modifiedValue="0.6"/>
                    <modifier type="MOTOR_RPM_REAL" value="2000" modifiedValue="1"/>
                    <modifier type="MOTOR_LOAD" value="0.0" modifiedValue="0"/>
                    <modifier type="MOTOR_LOAD" value="0.5" modifiedValue="0.35"/>
                    <modifier type="MOTOR_LOAD" value="1.0" modifiedValue="0.9"/>
                </volume>
                <pitch indoor="1" outdoor="1">
                    <modifier type="MOTOR_RPM_REAL" value="800" modifiedValue="0.4"/>
                    <modifier type="MOTOR_RPM_REAL" value="2600" modifiedValue="1.3"/>
                </pitch>
            </motor>
        </sounds>
    </motorized>

    <honk>
        <sound file="sounds/greeting.ogg" linkNode="soundMotor" linkNodeOffset="0 0.4 0.6" innerRadius="8" outerRadius="110" loops="1">
            <volume indoor="0.8" outdoor="1.0"/>
        </sound>
    </honk>

    <fillUnit>
        <fillUnitConfigurations>
            <fillUnitConfiguration>
                <fillUnits>
                    <fillUnit unitTextOverride="$l10n_unit_literShort" showOnHud="false" showInShop="false" fillTypes="diesel" capacity="120">
                        <exactFillRootNode node="exactFillRootNode"/>
                    </fillUnit>
                </fillUnits>
            </fillUnitConfiguration>
        </fillUnitConfigurations>
    </fillUnit>

    <!-- I3D_MAPPINGS -->
    <i3dMappings>
    </i3dMappings>
    <!-- /I3D_MAPPINGS -->
</vehicle>
