<?xml version="1.0" encoding="utf-8" standalone="no"?>
<vehicle type="UFO4500" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://validation.gdn.giants-software.com/xml/fs25/vehicle.xsd">
    <annotation>
        UFO 4500 - the harvester. Same saucer, but this one really cuts: it
        carries a 6 m cutter (ufo4500header.xml, a separate store item) and
        threshes into its own grain tank. No Lua, base game specializations
        only, so it works on console as well.
    </annotation>

    <storeData>
        <name>$l10n_ufo4500_name</name>
        <specs>
            <power>300</power>
            <maxSpeed>25</maxSpeed>
        </specs>
        <functions>
            <function>$l10n_function_ufo4500</function>
        </functions>
        <image>store_ufo4500.png</image>
        <price>185000</price>
        <lifetime>600</lifetime>
        <rotation>0</rotation>
        <brand>LIZARD</brand>
        <category>harvesters</category>
        <shopTranslationOffset>0 -0.05 0</shopTranslationOffset>
        <shopRotationOffset>0 0 0</shopRotationOffset>
        <vertexBufferMemoryUsage>0</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>0</indexBufferMemoryUsage>
        <textureMemoryUsage>0</textureMemoryUsage>
        <audioMemoryUsage>0</audioMemoryUsage>
    </storeData>

    <base>
        <typeDesc>$l10n_typeDesc_ufo4500</typeDesc>
        <filename>ufo4500.i3d</filename>
        <size width="4.8" length="4.8" height="4.2"/>
        <speedLimit value="25"/>
        <components>
            <component centerOfMass="0 0.9 0" solverIterationCount="20" mass="4200"/>
        </components>
        <schemaOverlay name="COMBINE" attacherJointPosition="0 0"/>
        <mapHotspot type="HARVESTER"/>
    </base>

    <wheels>
        <wheelConfigurations>
            <!-- WHEELS -->
        </wheelConfigurations>
    </wheels>

    <enterable isTabbable="true">
        <exitPoint node="exitPoint"/>
        <enterReferenceNode node="enterReferenceNode"/>
        <characterNode node="driverSeatNode" cameraMinDistance="0.5"/>
        <cameras>
            <camera node="outdoorCamera" rotatable="true" rotateNode="outdoorCameraTarget" limit="true" useWorldXZRotation="true" rotMinX="-1.5" rotMaxX="1.0" transMin="8" transMax="60" translation="0 0 18" rotation="-14 180 0"/>
            <camera node="indoorCamera" rotatable="true" limit="true" rotMinX="-1.0" rotMaxX="0.6" transMin="0" transMax="0" isInside="true"/>
        </cameras>
    </enterable>

    <lights>
        <beaconLights>
            <beaconLight node="cockpitBeacon1" filename="$data/shared/assets/beaconLights/lizard/beaconLight06.xml" alwaysActive="true" speed="2"/>
            <beaconLight node="cockpitBeacon2" filename="$data/shared/assets/beaconLights/lizard/beaconLight06.xml" alwaysActive="true" speed="2"/>
        </beaconLights>

        <states>
            <state lightTypes="0"/>
            <state lightTypes="0 1"/>
        </states>
        <realLights>
            <low>
                <light node="headLightLeft" lightTypes="0"/>
                <light node="headLightRight" lightTypes="0"/>
                <light node="workLight" lightTypes="1"/>
                <light node="beamLight" lightTypes="1"/>
                <light node="tailLight" lightTypes="0"/>
                <light node="beaconLight" lightTypes="0 1"/>
            </low>
            <high>
                <light node="headLightLeft" lightTypes="0"/>
                <light node="headLightRight" lightTypes="0"/>
                <light node="workLight" lightTypes="1"/>
                <light node="beamLight" lightTypes="1"/>
                <light node="tailLight" lightTypes="0"/>
                <light node="beaconLight" lightTypes="0 1"/>
            </high>
        </realLights>
    </lights>

    <motorized>
        <consumerConfigurations>
            <consumerConfiguration>
                <consumer fillUnitIndex="2" usage="28" fillType="diesel"/>
            </consumerConfiguration>
        </consumerConfigurations>

        <motorConfigurations>
            <motorConfiguration name="$l10n_configuration_valueDefault" hp="300" price="0" consumerConfigurationIndex="1">
                <motor minRpm="800" maxRpm="2100" maxForwardSpeed="25" maxBackwardSpeed="12" accelerationLimit="4" brakeForce="8" lowBrakeForceScale="1" ptoMotorRpmRatio="0">
                    <torque rpm="800" torque="0.55"/>
                    <torque rpm="1400" torque="0.72"/>
                    <torque rpm="2100" torque="0.60"/>
                </motor>
                <transmission gearChangeTime="0" autoGearChangeTime="0.2" name="$l10n_info_transmission_automatic">
                    <directionChange useGear="false" changeTime="0.3"/>
                    <forwardGear maxSpeed="25" name="D"/>
                    <backwardGear maxSpeed="12" name="R"/>
                </transmission>
            </motorConfiguration>
        </motorConfigurations>

        <sounds>
            <motorStart file="sounds/hoverStart.ogg" linkNode="soundMotor" innerRadius="6" outerRadius="120">
                <volume indoor="0.7" outdoor="0.9"/>
            </motorStart>
            <motorStop file="sounds/hoverStop.ogg" linkNode="soundMotor" innerRadius="6" outerRadius="120">
                <volume indoor="0.7" outdoor="0.9"/>
            </motorStop>
            <motor file="sounds/hoverIdle.ogg" linkNode="soundMotor" innerRadius="8" outerRadius="130" fadeIn="0.3" fadeOut="0.3">
                <volume indoor="0.85" outdoor="1.0">
                    <modifier type="MOTOR_RPM_REAL" value="700" modifiedValue="1"/>
                    <modifier type="MOTOR_RPM_REAL" value="900" modifiedValue="1"/>
                    <modifier type="MOTOR_RPM_REAL" value="1000" modifiedValue="0.8"/>
                    <modifier type="MOTOR_RPM_REAL" value="1100" modifiedValue="0.45"/>
                    <modifier type="MOTOR_RPM_REAL" value="1200" modifiedValue="0"/>
                    <modifier type="MOTOR_LOAD" value="0.0" modifiedValue="1.0"/>
                    <modifier type="MOTOR_LOAD" value="1.0" modifiedValue="0.55"/>
                </volume>
                <pitch indoor="1" outdoor="1">
                    <modifier type="MOTOR_RPM_REAL" value="800" modifiedValue="1"/>
                    <modifier type="MOTOR_RPM_REAL" value="2100" modifiedValue="2.6"/>
                </pitch>
            </motor>
            <motor file="sounds/hoverMid.ogg" linkNode="soundMotor" innerRadius="8" outerRadius="130" fadeIn="0.3" fadeOut="0.3">
                <volume indoor="0.85" outdoor="1.0">
                    <modifier type="MOTOR_RPM_REAL" value="1100" modifiedValue="0"/>
                    <modifier type="MOTOR_RPM_REAL" value="1250" modifiedValue="0.5"/>
                    <modifier type="MOTOR_RPM_REAL" value="1400" modifiedValue="1"/>
                    <modifier type="MOTOR_RPM_REAL" value="1750" modifiedValue="1"/>
                    <modifier type="MOTOR_RPM_REAL" value="1900" modifiedValue="0.5"/>
                    <modifier type="MOTOR_RPM_REAL" value="2050" modifiedValue="0"/>
                    <modifier type="MOTOR_LOAD" value="0.0" modifiedValue="1.0"/>
                    <modifier type="MOTOR_LOAD" value="1.0" modifiedValue="0.7"/>
                </volume>
                <pitch indoor="1" outdoor="1">
                    <modifier type="MOTOR_RPM_REAL" value="800" modifiedValue="0.5"/>
                    <modifier type="MOTOR_RPM_REAL" value="2100" modifiedValue="1.31"/>
                </pitch>
            </motor>
            <motor file="sounds/hoverHigh.ogg" linkNode="soundMotor" innerRadius="8" outerRadius="130" fadeIn="0.3" fadeOut="0.3">
                <volume indoor="0.85" outdoor="1.0">
                    <modifier type="MOTOR_RPM_REAL" value="1950" modifiedValue="0"/>
                    <modifier type="MOTOR_RPM_REAL" value="2150" modifiedValue="0.5"/>
                    <modifier type="MOTOR_RPM_REAL" value="2300" modifiedValue="1"/>
                    <modifier type="MOTOR_RPM_REAL" value="2700" modifiedValue="1"/>
                    <modifier type="MOTOR_LOAD" value="0.0" modifiedValue="1.0"/>
                    <modifier type="MOTOR_LOAD" value="1.0" modifiedValue="0.8"/>
                </volume>
                <pitch indoor="1" outdoor="1">
                    <modifier type="MOTOR_RPM_REAL" value="800" modifiedValue="0.333"/>
                    <modifier type="MOTOR_RPM_REAL" value="2100" modifiedValue="0.875"/>
                </pitch>
            </motor>
            <motor file="sounds/hoverLoad.ogg" linkNode="soundMotor" innerRadius="8" outerRadius="130" fadeIn="0.3" fadeOut="0.3">
                <volume indoor="0.85" outdoor="1.0">
                    <modifier type="MOTOR_RPM_REAL" value="1400" modifiedValue="0"/>
                    <modifier type="MOTOR_RPM_REAL" value="1700" modifiedValue="0.6"/>
                    <modifier type="MOTOR_RPM_REAL" value="2000" modifiedValue="1"/>
                    <modifier type="MOTOR_LOAD" value="0.0" modifiedValue="0"/>
                    <modifier type="MOTOR_LOAD" value="0.5" modifiedValue="0.35"/>
                    <modifier type="MOTOR_LOAD" value="1.0" modifiedValue="0.9"/>
                </volume>
                <pitch indoor="1" outdoor="1">
                    <modifier type="MOTOR_RPM_REAL" value="800" modifiedValue="0.4"/>
                    <modifier type="MOTOR_RPM_REAL" value="2100" modifiedValue="1.05"/>
                </pitch>
            </motor>
        </sounds>
    </motorized>

    <honk>
        <sound file="sounds/greeting.ogg" linkNode="soundMotor" linkNodeOffset="0 0.4 0.6" innerRadius="8" outerRadius="110" loops="1">
            <volume indoor="0.8" outdoor="1.0"/>
        </sound>
    </honk>

    <!-- the combine needs a work area specialization; the actual work area
         lives on the header -->
    <workAreas>
    </workAreas>

    <fillUnit>
        <fillUnitConfigurations>
            <fillUnitConfiguration>
                <fillUnits>
                    <fillUnit unitTextOverride="$l10n_unit_literShort" fillTypes="WHEAT BARLEY OAT CANOLA MAIZE SUNFLOWER SOYBEAN SORGHUM" capacity="15000">
                        <exactFillRootNode node="exactFillRootNode"/>
                    </fillUnit>
                    <fillUnit unitTextOverride="$l10n_unit_literShort" showOnHud="false" showInShop="false" fillTypes="diesel" capacity="600">
                        <exactFillRootNode node="exactFillRootNode"/>
                    </fillUnit>
                </fillUnits>
            </fillUnitConfiguration>
        </fillUnitConfigurations>
    </fillUnit>

    <!-- the base game combine logic: the cutter reports the harvested litres -->
    <combine fillUnitIndex="1" allowThreshingDuringRain="true">
        <swath available="false"/>
        <chopper available="false"/>
    </combine>

    <!-- grain tank outlet: the pipe is always extended, the unloading trigger
         sits under the tip of the pipe -->
    <pipe dischargeNodeIndex="1">
        <states num="1" unloading="1"/>
        <unloadingTriggers>
            <unloadingTrigger node="pipeTip"/>
        </unloadingTriggers>
    </pipe>

    <dischargeable>
        <dischargeNode node="dischargeNode" emptySpeed="300" fillUnitIndex="1" maxDistance="9">
            <raycast yOffset="1" useWorldNegYDirection="true"/>
            <info width="0.4" length="0.4" useRaycastHitPosition="true"/>
        </dischargeNode>
    </dischargeable>

    <attacherJoints>
        <attacherJointConfigurations>
            <attacherJointConfiguration name="$l10n_configuration_valueDefault" price="0">
                <attacherJoint node="attacherJoint" jointType="cutter" jointPositionOffset="0 0 0" lowerTransLimit="0 0 0" lowerRotLimit="0 0 0" lockDownRotLimit="true" moveTime="2.5" comboTime="0" delayedObjectChanges="false" delayedObjectChangesOnAttach="true">
                    <distanceToGround lower="0.07" upper="2.0"/>
                    <rotationNode node="attacherRotation" lowerRotation="3 0 0" upperRotation="-13 0 0" startRotation="0 0 0"/>
                    <schema position="1 0" rotation="0" invertX="true"/>
                </attacherJoint>
            </attacherJointConfiguration>
        </attacherJointConfigurations>
    </attacherJoints>

    <turnOnVehicle turnedOnByAttacherVehicle="false"/>

    <!-- I3D_MAPPINGS -->
    <i3dMappings>
    </i3dMappings>
    <!-- /I3D_MAPPINGS -->
</vehicle>
