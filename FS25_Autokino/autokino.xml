<?xml version="1.0" encoding="utf-8" standalone="no"?>
<placeable type="autokino" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://validation.gdn.giants-software.com/xml/fs25/placeable.xsd">
    <annotation>
        FS25_Autokino - a drive-in cinema. The screen shows one of three short
        cartoons, the soundtrack plays for everyone on the lot. The film is
        chosen by the server and the frame is computed from the network time,
        so all players see the same picture at the same moment.
    </annotation>

    <storeData>
        <name>$l10n_autokino_name</name>
        <image>store_autokino.png</image>
        <price>48000</price>
        <functions>
            <function>$l10n_autokino_function</function>
        </functions>
        <lifetime>1000</lifetime>
        <dailyUpkeep>35</dailyUpkeep>
        <rotation>0</rotation>
        <brand>LIZARD</brand>
        <species>PLACEABLE</species>
        <category>placeableMisc</category>
        <brush>
            <type>placeable</type>
            <category>object</category>
        </brush>
        <vertexBufferMemoryUsage>0</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>0</indexBufferMemoryUsage>
        <textureMemoryUsage>0</textureMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
        <storeIconRendering>
            <settings cameraXRot="-14" cameraYRot="34" advancedBoundingBox="true"/>
        </storeIconRendering>
        <audioMemoryUsage>0</audioMemoryUsage>
    </storeData>

    <base>
        <filename>autokino.i3d</filename>
        <boughtWithFarmland>true</boughtWithFarmland>
        <canBeDeleted>true</canBeDeleted>
        <canBeRenamed>true</canBeRenamed>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true">
        <testAreas>
            <testArea startNode="testArea1" endNode="testArea1End"/>
        </testAreas>
        <sounds>
            <place template="smallImp"/>
            <placeLayered template="buildingPlacement"/>
        </sounds>
    </placement>

    <clearAreas>
        <clearArea startNode="clearArea1" widthNode="clearArea1Width" heightNode="clearArea1Height"/>
    </clearAreas>

    <leveling requireLeveling="true" maxSmoothDistance="12" maxSlope="45" maxEdgeAngle="30">
        <levelAreas>
            <levelArea startNode="levelArea1" widthNode="levelArea1Width" heightNode="levelArea1Height" groundType="dirt"/>
        </levelAreas>
        <paintAreas>
            <paintArea startNode="paintArea1" widthNode="paintArea1Width" heightNode="paintArea1Height" groundType="grass"/>
        </paintAreas>
    </leveling>

    <indoorAreas>
        <indoorArea startNode="indoorArea1" widthNode="indoorArea1Width" heightNode="indoorArea1Height"/>
    </indoorAreas>

    <foliageAreas>
        <foliageArea startNode="foliageArea1" widthNode="foliageArea1Width" heightNode="foliageArea1Height"/>
    </foliageAreas>

    <ai>
        <updateAreas>
            <updateArea startNode="testArea1" endNode="testArea1End"/>
        </updateAreas>
    </ai>

    <!-- I3D_MAPPINGS -->
    <i3dMappings>
        <i3dMapping id="autokino" node="0>"/>
        <i3dMapping id="lotMesh" node="0>0"/>
        <i3dMapping id="frameMesh" node="0>1"/>
        <i3dMapping id="screenMesh" node="0>2"/>
        <i3dMapping id="boothMesh" node="0>3"/>
        <i3dMapping id="detailMesh" node="0>4"/>
        <i3dMapping id="neonSign" node="0>5"/>
        <i3dMapping id="screenLight" node="0>6"/>
        <i3dMapping id="colScreen" node="0>7"/>
        <i3dMapping id="colBooth" node="0>8"/>
        <i3dMapping id="colMast1" node="0>9"/>
        <i3dMapping id="colMast2" node="0>10"/>
        <i3dMapping id="colMast3" node="0>11"/>
        <i3dMapping id="colMast4" node="0>12"/>
        <i3dMapping id="cinemaTrigger" node="0>13"/>
        <i3dMapping id="filmSoundNode" node="0>14"/>
        <i3dMapping id="testArea1" node="0>15"/>
        <i3dMapping id="testArea1End" node="0>15|0"/>
        <i3dMapping id="clearArea1" node="0>16"/>
        <i3dMapping id="clearArea1Width" node="0>16|0"/>
        <i3dMapping id="clearArea1Height" node="0>16|1"/>
        <i3dMapping id="levelArea1" node="0>17"/>
        <i3dMapping id="levelArea1Width" node="0>17|0"/>
        <i3dMapping id="levelArea1Height" node="0>17|1"/>
        <i3dMapping id="paintArea1" node="0>18"/>
        <i3dMapping id="paintArea1Width" node="0>18|0"/>
        <i3dMapping id="paintArea1Height" node="0>18|1"/>
        <i3dMapping id="foliageArea1" node="0>19"/>
        <i3dMapping id="foliageArea1Width" node="0>19|0"/>
        <i3dMapping id="foliageArea1Height" node="0>19|1"/>
        <i3dMapping id="indoorArea1" node="0>20"/>
        <i3dMapping id="indoorArea1Width" node="0>20|0"/>
        <i3dMapping id="indoorArea1Height" node="0>20|1"/>
    </i3dMappings>
    <!-- /I3D_MAPPINGS -->
</placeable>
